---
import FeaturedPlayer from '../../components/FeaturedPlayer.astro';
import TrackCard from '../../components/TrackCard.astro';
import { tracks } from '../../data/tracks';
import SiteLayout from '../../layouts/SiteLayout.astro';

const latestTrack = tracks[0]!;
const originalTracks = tracks.filter((track) => track.format === 'Original');
const reinterpretations = tracks.filter((track) => track.format !== 'Original');
const trackIndex = (track: (typeof tracks)[number]) => tracks.indexOf(track);
const uploadCount = (count: number) => `${count} ${count === 1 ? 'upload' : 'uploads'}`;
const spotifyPlaylistUrl = 'https://open.spotify.com/playlist/4627RK8bmbXSTGxg0w9MDf';
const spotifyEmbedUrl = 'https://open.spotify.com/embed/playlist/4627RK8bmbXSTGxg0w9MDf?utm_source=generator';
---

<SiteLayout title="Music" description="Listen to my electronic tracks and sample flips." image={latestTrack.artwork}>
  <div class="music-stack">
    <FeaturedPlayer track={latestTrack} />

    <section id="originals" class="track-section" aria-labelledby="originals-title">
      <div class="section-heading">
        <div>
          <h2 id="originals-title">Original tracks</h2>
        </div>
        <p>{uploadCount(originalTracks.length)}</p>
      </div>
      <div class="track-grid">
        {
          originalTracks.map((track) => {
            const index = trackIndex(track);
            return <TrackCard track={track} index={index} priority={index < 3} />;
          })
        }
      </div>
    </section>

    <section id="sample-flips" class="track-section" aria-labelledby="reinterpretations-title">
      <div class="section-heading">
        <div>
          <h2 id="reinterpretations-title">Sample flip</h2>
        </div>
        <p>{uploadCount(reinterpretations.length)}</p>
      </div>
      <div class="track-grid track-grid--two">
        {
          reinterpretations.map((track) => {
            const index = trackIndex(track);
            return <TrackCard track={track} index={index} priority={index < 3} />;
          })
        }
      </div>
    </section>

    <section id="inspiration" class="track-section" aria-labelledby="inspiration-title">
      <div class="section-heading">
        <div>
          <h2 id="inspiration-title">Inspiration playlist</h2>
        </div>
        <p>Spotify</p>
      </div>
      <div class="playlist-panel">
        <iframe
          src={spotifyEmbedUrl}
          title="Spotify playlist: kashii*inspo"
          width="100%"
          height="352"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          allowfullscreen></iframe>
        <a class="action-button action-button--ghost" href={spotifyPlaylistUrl} target="_blank" rel="noreferrer">
          Open kashii*inspo on Spotify <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <script src="../../scripts/music.ts"></script>
</SiteLayout>

<style>
  .music-stack {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
  }

  .track-section {
    scroll-margin-block-start: 5rem;
  }

  .section-heading > div {
    display: grid;
    gap: 0.45rem;
  }

  .track-grid--two {
    width: min(100%, calc((100% - 2.7rem) / 3));
    grid-template-columns: 1fr;
    margin-inline: auto;
  }

  .playlist-panel {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .playlist-panel iframe {
    display: block;
    border: 0;
    border-radius: 0.75rem;
  }

  @media (max-width: 900px) {
    .track-grid--two {
      width: min(100%, calc((100% - 1.35rem) / 2));
    }
  }

  @media (max-width: 640px) {
    .track-grid--two {
      width: 100%;
    }
  }
</style>
